---
// The posts on a washing line: rows of <Slip>s, each drawing its own stretch of one sagging line.
// On phones the line becomes one thread down the page, with each slip tied on at a knot.
---
<ol class="washing" role="list"><slot /></ol>

<style>
  .washing {
    --cols: 3;
    --gap: clamp(1.5rem, 4vw, 3.5rem);
    --line-h: clamp(3.5rem, 7vw, 5.5rem);
    --peg-h: 5rem;
    --step: calc((100cqi + var(--gap)) / var(--cols)); /* one slip and one gap */
    container-type: inline-size;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 4.5rem var(--gap);
    margin: 4rem 0 0;
    padding: 0;
  }
  @media (max-width: 64rem) {
    .washing { --cols: 2; }
  }
  @media (max-width: 40rem) {
    .washing { --cols: 1; position: relative; gap: 2.5rem; padding-left: 2.2rem; }
    .washing::before {
      content: ""; position: absolute; left: .6rem; top: -1.5rem; bottom: -2rem; width: 1.2rem;
      background: currentColor;
      -webkit-mask: url("../../assets/ink/line-v.svg") 0 0 / 100% 100%;
      mask: url("../../assets/ink/line-v.svg") 0 0 / 100% 100%;
    }
  }
</style>
