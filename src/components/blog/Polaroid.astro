---
// A snapshot with a wide bottom border to write on, taped to the page at a tilt.
//   <Polaroid src={photo} alt="…">the desk, 2am</Polaroid>
//   <Polaroid src={photo} alt="…" tilt={2} side="right">…</Polaroid>
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
interface Props { src: ImageMetadata; alt: string; tilt?: number; side?: "center" | "left" | "right" }
const { src, alt, tilt = -2, side = "center" } = Astro.props;
---
<figure class:list={["polaroid", side]} style={`--tilt:${tilt}deg`}>
  <span class="tape" aria-hidden="true"></span>
  <Picture src={src} alt={alt} formats={["avif", "webp"]} widths={[320, 480, 640]} sizes="18rem" />
  <figcaption><slot /></figcaption>
</figure>

<style>
  .polaroid {
    position: relative;
    justify-self: center;
    width: min(18rem, 80%);
    margin: 2.6rem 0 2.8rem;
    padding: .8rem .8rem 0;
    background: color-mix(in oklab, var(--sheet), white 40%) url("../../assets/paper/grain.webp") 0 0 / 800px;
    background-blend-mode: multiply;
    box-shadow: 0 1px 0 var(--paper-edge), 0 20px 34px -24px var(--shade);
    rotate: var(--tilt);
  }
  .left { justify-self: start; }
  .right { justify-self: end; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .polaroid { background-color: color-mix(in oklab, var(--sheet), white 8%); } }
  :root[data-theme="dark"] .polaroid { background-color: color-mix(in oklab, var(--sheet), white 8%); }
  /* the <img> is rendered by <Picture>, so outside this file's scope; a snapshot is square */
  .polaroid :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
  figcaption { min-height: 3.4rem; padding: .7rem .2rem .9rem; font-style: italic; color: var(--pencil); font-size: 1.05rem; line-height: 1.3; text-align: center; text-wrap: balance; }
  .tape {
    position: absolute; z-index: 1; left: 50%; top: -.8rem; width: 5.5rem; height: 1.6rem; translate: -50% 0; rotate: calc(var(--tilt) * -1.5 + 2deg);
    background: color-mix(in oklab, var(--ink) 9%, color-mix(in oklab, var(--sheet) 70%, transparent));
    clip-path: polygon(0 8%, 4% 0, 8% 12%, 12% 2%, 88% 0, 92% 10%, 96% 0, 100% 14%, 100% 92%, 96% 100%, 92% 88%, 88% 100%, 12% 96%, 8% 100%, 4% 88%, 0 100%);
  }
</style>
