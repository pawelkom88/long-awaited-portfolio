---
import { ink } from "../../lib/ink";
---
<section class="work" aria-labelledby="work-h">
  <h2 id="work-h"><span class="pencil hand">P.S.</span> Things I make that nobody asked for</h2>
  <p class="soft">Small macOS and iOS tools, each one started as a little annoyance.</p>
  <ul class="shelf" role="list">
    <li class="thing boil-on-hover" style="--w:clamp(2.7rem, 5.1vw, 3.75rem)">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target"><span class="ink" aria-hidden="true" style={`--src:url(${ink("broom")}); --ar:433/794`}></span></span>
      <span class="label">TidyShot <small>clears the screenshot pile</small></span>
    </li>
    <li class="thing boil-on-hover" style="--w:clamp(2.7rem, 5.3vw, 3.8rem); --sink:15%">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target"><span class="ink" aria-hidden="true" style={`--src:url(${ink("lens")}); --ar:478/524`}></span></span>
      <span class="label">Glance <small>one look at what matters</small></span>
    </li>
    <li class="thing boil-on-hover" style="--w:clamp(1.35rem, 2.4vw, 1.8rem)">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target"><span class="ink" aria-hidden="true" style={`--src:url(${ink("match")}); --ar:230/857`}></span></span>
      <span class="label">Promptheus <small>keeps the good prompts lit</small></span>
    </li>
    <li class="thing boil-on-hover" style="--w:clamp(2.1rem, 4vw, 2.9rem)">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target"><span class="ink" aria-hidden="true" style={`--src:url(${ink("watch")}); --ar:300/537`}></span></span>
      <span class="label">Devlog <small>counts the hours, writes the bill</small></span>
    </li>
    <li class="thing boil-on-hover" style="--w:clamp(2.7rem, 5vw, 3.6rem)">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target"><span class="ink" aria-hidden="true" style={`--src:url(${ink("window")}); --ar:400/419`}></span></span>
      <span class="label">Loopset <small>a place for every window</small></span>
    </li>
  </ul>
  <div class="thread">
    <span class="ink" aria-hidden="true" style={`--src:url(${ink("line-3")}); --ar:2472/92`}></span>
    <button type="button" class="snag" style="left:90%" aria-label="Pluck the tied knot"><span class="boil" aria-hidden="true" style="display:block"><span class="ink" style={`--src:url(${ink("knot-1")}); --ar:580/200`}></span></span></button>
    <span class="sr-only" id="snag-live" aria-live="polite"></span>
  </div>
  <p class="soft shelf-bench"><a href="/projects/">The next one is still on the bench</a>.</p>
</section>
