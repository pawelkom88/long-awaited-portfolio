---
import { ink } from "../../lib/ink";
---
<section class="work" aria-labelledby="work-h">
  <h2 id="work-h"><span class="pencil hand">P.S.</span> Things I make that nobody asked for</h2>
  <p class="soft">Small macOS and iOS tools, each one started as a little annoyance.</p>
  <div class="shelf">
    <div class="thing boil-on-hover">
      <span class="ink pencil ring" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(2.7rem, 5.1vw, 3.75rem)"><span class="ink" style={`--src:url(${ink("broom")}); --ar:433/794`}></span></span>
      <a class="label" href="#">tidyshot<small>clears the screenshot pile</small></a>
    </div>
    <div class="thing boil-on-hover">
      <span class="ink pencil ring" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(2.7rem, 5.3vw, 3.8rem); --sink:15%"><span class="ink" style={`--src:url(${ink("lens")}); --ar:478/524`}></span></span>
      <a class="label" href="#">glance<small>one look at what matters</small></a>
    </div>
    <div class="thing boil-on-hover">
      <span class="ink pencil ring" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(1.7rem, 3vw, 2.3rem); --sink:15%"><span class="ink" style={`--src:url(${ink("paperclip")}); --ar:284/419`}></span></span>
      <a class="label" href="#">keepclip<small>holds on to what you copied</small></a>
    </div>
    <div class="thing boil-on-hover">
      <span class="ink pencil ring" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(2.3rem, 4.5vw, 3.2rem)"><span class="ink" style={`--src:url(${ink("lamp")}); --ar:404/499`}></span></span>
      <a class="label" href="#">wherewasi<small>leaves a light on</small></a>
    </div>
    <div class="thing boil-on-hover">
      <span class="ink pencil ring" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(1.8rem, 3.4vw, 2.4rem); --sink:8%"><span class="ink" style={`--src:url(${ink("string-loop")}); --ar:366/433`}></span></span>
      <a class="label" href="#">latchlog<small>ties off each day</small></a>
    </div>
  </div>
  <div class="thread">
    <span class="ink" style={`--src:url(${ink("line-3")}); --ar:2472/92`}></span>
    <span class="snag" style="left:90%" tabindex="0"><span class="boil" style="display:block"><span class="ink" style={`--src:url(${ink("knot-1")}); --ar:580/200`}></span></span><span class="snag-note">took a week, worth it</span></span>
  </div>
</section>
