---
// A picture on a sheet, held down at one corner (tape, or a paperclip), captioned in pencil.
//   <Figure src={shot} alt="…">caption, optional</Figure>
// The image is optimised by astro:assets: AVIF and WebP, sized for the column.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Ink from "../ink/Ink.astro";
interface Props { src: ImageMetadata; alt: string; hold?: "tape" | "clip" }
const { src, alt, hold = "tape" } = Astro.props;
---
<figure class:list={["figure", `hold-${hold}`]}>
  {hold === "clip" ? <Ink name="paperclip" class="clip" aria-hidden="true" /> : <span class="tape" aria-hidden="true"></span>}
  <Picture src={src} alt={alt} formats={["avif", "webp"]} widths={[480, 720, 960, 1340, 2000]} sizes="(min-width: 44rem) 42rem, calc(100vw - 2rem)" />
  {Astro.slots.has("default") && <figcaption><slot /></figcaption>}
</figure>

<style>
  .figure {
    grid-column: wide;
    justify-self: center;
    position: relative;
    margin: 2.2rem 0 2.8rem;
    padding: .75rem .75rem 0;
    background: var(--sheet) url("../../assets/paper/grain.webp") 0 0 / 800px;
    background-blend-mode: multiply;
    box-shadow: 0 1px 0 var(--paper-edge), 0 22px 40px -28px var(--shade);
    rotate: .5deg;
  }
  .figure:not(:has(figcaption)) { padding-bottom: .75rem; }
  /* the <img> and the clip are rendered by <Picture> and <Ink>, so outside this file's scope */
  .figure :global(img) { display: block; max-width: 100%; height: auto; }
  /* a bright picture on a night page: dimmed a touch, like paper under a lamp */
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .figure :global(img) { filter: brightness(.85); } }
  :root[data-theme="dark"] .figure :global(img) { filter: brightness(.85); }
  figcaption { padding: .7rem .2rem 1rem; font-style: italic; color: var(--pencil); font-size: 1rem; line-height: 1.4; }
  /* the tape: a translucent strip with torn ends */
  .tape {
    position: absolute; z-index: 1; left: -1.6rem; top: .4rem; width: 6rem; height: 1.7rem; rotate: -38deg;
    background: color-mix(in oklab, var(--ink) 9%, color-mix(in oklab, var(--sheet) 70%, transparent));
    clip-path: polygon(0 8%, 4% 0, 8% 12%, 12% 2%, 88% 0, 92% 10%, 96% 0, 100% 14%, 100% 92%, 96% 100%, 92% 88%, 88% 100%, 12% 96%, 8% 100%, 4% 88%, 0 100%);
  }
  .figure :global(.clip) { position: absolute; z-index: 1; top: -1rem; right: 2rem; width: 1.9rem; color: var(--ink); rotate: -8deg; }
  @media (max-width: 40rem) {
    .figure { grid-column: full; margin-inline: var(--gutter); rotate: none; }
  }
</style>
