---
// One post: typed onto the notebook, with the post components available in its MDX without imports.
import Base from "../../layouts/Base.astro";
import "../../styles/blog.css";
import { render } from "astro:content";
import { posts, typedDate, readingTime, wordCount, type Post } from "../../lib/posts";
import { post as schema } from "../../lib/schema";
import { BLOG, AUTHOR } from "../../site.mjs";
import CodeSheet from "../../components/blog/CodeSheet.astro";
import Figure from "../../components/blog/Figure.astro";
import Note from "../../components/blog/Note.astro";
import Polaroid from "../../components/blog/Polaroid.astro";
import Pullquote from "../../components/blog/Pullquote.astro";
import Sketch from "../../components/blog/Sketch.astro";

export async function getStaticPaths() {
  return (await posts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
const { title, description, date, updated } = post.data;
const { Content } = await render(post);
const iso = date.toISOString().slice(0, 10);
const path = `/blog/${post.id}/`;
---
<Base title={`${title} · ${BLOG.name}`} description={description} type="article" schema={schema({ title, description, path, date, updated, image: "/og.png", words: wordCount(post.body) })} inBlog>
  <Fragment slot="head">
    <meta property="article:published_time" content={iso}>
    <meta property="article:author" content={AUTHOR}>
    <meta property="article:section" content={BLOG.name}>
  </Fragment>
  <main id="main" tabindex="-1">
    <article class="post">
      <header class="post-head" id="top-of-page">
        <h1>{title}</h1>
        <p class="typed meta"><time datetime={iso}>{typedDate(date)}</time> &middot; {readingTime(post.body)}</p>
      </header>
      <Content components={{ pre: CodeSheet, Figure, Note, Polaroid, Pullquote, Sketch }} />
      <p class="back"><a href="/blog/">Back to the line</a></p>
    </article>
  </main>
</Base>
