---
// Loose ends: every post, pegged to a washing line, newest first.
import Base from "../../layouts/Base.astro";
import "../../styles/blog.css";
import WashingLine from "../../components/blog/WashingLine.astro";
import Slip from "../../components/blog/Slip.astro";
import { posts, typedDate } from "../../lib/posts";
import { AUTHOR, BLOG } from "../../site.mjs";
import { blog } from "../../lib/schema";
const all = await posts();
const schema = blog(all.map(p => ({ title: p.data.title, path: `/blog/${p.id}/`, date: p.data.date })));
---
<Base title={`${BLOG.name}: notes on front end work · ${AUTHOR}`} description={BLOG.description} schema={schema} inBlog>
  <main id="main" tabindex="-1">
    <section class="blog-head" id="top-of-page" aria-labelledby="blog-h">
      <h1 id="blog-h">{BLOG.name}</h1>
      <p class="soft lede">Thoughts I've tied off and hung up to dry. Mostly front end, now and then people.</p>
    </section>
    <section aria-label="Posts">
      <WashingLine>
        {all.map(p => (
          <Slip href={`/blog/${p.id}/`} title={p.data.title} date={p.data.date} dateText={typedDate(p.data.date)} description={p.data.description} />
        ))}
      </WashingLine>
    </section>
  </main>
</Base>
