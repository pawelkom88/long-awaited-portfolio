---
import { ink } from "../../lib/ink";
---
<section class="work" aria-labelledby="work-h">
  <h2 id="work-h"><span class="pencil hand">P.S.</span> Things I make that nobody asked for</h2>
  <p class="soft">Small macOS and iOS tools, each one started as a little annoyance.</p>
  <ul class="shelf" role="list">
    <li class="thing boil-on-hover">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(2.7rem, 5.1vw, 3.75rem)"><span class="ink" aria-hidden="true" style={`--src:url(${ink("broom")}); --ar:433/794`}></span></span>
      <a class="label" href="#">TidyShot<small>clears the screenshot pile</small></a>
    </li>
    <li class="thing boil-on-hover">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(2.7rem, 5.3vw, 3.8rem); --sink:15%"><span class="ink" aria-hidden="true" style={`--src:url(${ink("lens")}); --ar:478/524`}></span></span>
      <a class="label" href="#">Glance<small>one look at what matters</small></a>
    </li>
    <li class="thing boil-on-hover">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(1.35rem, 2.4vw, 1.8rem)"><span class="ink" aria-hidden="true" style={`--src:url(${ink("match")}); --ar:230/857`}></span></span>
      <a class="label" href="#">Promptheus<small>keeps the good prompts lit</small></a>
    </li>
    <li class="thing boil-on-hover">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(2.1rem, 4vw, 2.9rem)"><span class="ink" aria-hidden="true" style={`--src:url(${ink("watch")}); --ar:300/537`}></span></span>
      <a class="label" href="#">Devlog<small>counts the hours, writes the bill</small></a>
    </li>
    <li class="thing boil-on-hover">
      <span class="ink pencil ring" aria-hidden="true" style={`--src:url(${ink("pencil/circle")}); --ar:292/280`}></span>
      <span class="obj boil-target" style="--w:clamp(2.7rem, 5vw, 3.6rem)"><span class="ink" aria-hidden="true" style={`--src:url(${ink("window")}); --ar:400/419`}></span></span>
      <a class="label" href="#">Loopset<small>a place for every window</small></a>
    </li>
  </ul>
  <div class="thread">
    <span class="ink" aria-hidden="true" style={`--src:url(${ink("line-3")}); --ar:2472/92`}></span>
    <button type="button" class="snag" style="left:90%" aria-label="Pluck the tied knot" aria-describedby="snag-tip"><span class="boil" aria-hidden="true" style="display:block"><span class="ink" style={`--src:url(${ink("knot-1")}); --ar:580/200`}></span></span><span class="snag-note" id="snag-tip" role="tooltip">took a week, worth it</span></button>
  </div>
  <p class="soft shelf-bench"><a href="/projects/">The next one is still on the bench</a>.</p>
</section>
