---
// Code, typed onto a lighter sheet and clipped on at the top corner. Every Markdown fence becomes one:
//   ```css title="ink.css" mark="1-3"
// The ink stays the ink (no syntax colours); marked lines get a pencil highlight and a tick in the margin.
import Ink from "../ink/Ink.astro";
const { "data-title": title, class: cls, ...attrs } = Astro.props;
---
<div class="code-sheet">
  <Ink name="paperclip" class="clip" aria-hidden="true" />
  {title && <p class="title typed">{title}</p>}
  <pre class={cls} tabindex="0" role="region" aria-label={title ? `Code snippet: ${title}` : "Code snippet"} {...attrs}><slot /></pre>
</div>

<style>
  .code-sheet {
    grid-column: wide;
    position: relative;
    margin: 1.8rem 0 2.4rem;
    padding: 2.2rem 0 1.5rem;
    background: var(--sheet) url("../../assets/paper/grain.webp") 0 0 / 800px;
    background-blend-mode: multiply;
    box-shadow: 0 1px 0 var(--paper-edge), 0 20px 36px -26px var(--shade);
    rotate: -.25deg;
  }
  /* rendered by <Ink>, so outside this file's scope */
  .code-sheet :global(.clip) { position: absolute; z-index: 1; top: -.9rem; left: 1.5rem; width: 2rem; color: var(--ink); rotate: 10deg; }
  .title { position: absolute; top: .55rem; right: 1.6rem; margin: 0; font-size: .78rem; letter-spacing: .04em; color: var(--ink-soft); }
  pre { margin: 0; font: .92rem/1.7 var(--typed); overflow-x: auto; }
  pre:focus-visible { outline: 2px solid var(--pencil); outline-offset: 2px; }
  pre :global(code) { display: block; padding: 0 1.6rem; tab-size: 2; font: inherit; }
  pre :global(mark) {
    color: inherit;
    background: linear-gradient(transparent 12%, color-mix(in oklab, var(--pencil) 16%, transparent) 12% 92%, transparent 92%);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  /* the tick: its containing block is the sheet, so it stays in the margin while the code scrolls */
  pre :global(mark)::before {
    content: ""; position: absolute; left: .7rem; width: 2px; height: 1.3em; margin-top: .2em;
    background: var(--pencil); border-radius: 1px; rotate: 3deg;
  }
  @media (max-width: 40rem) {
    .code-sheet { grid-column: full; rotate: none; }
    pre :global(code) { padding: 0 var(--gutter) 0 calc(var(--gutter) + .4rem); }
    .code-sheet :global(.clip) { left: var(--gutter); }
    pre :global(mark)::before { left: .35rem; }
  }
</style>
