---
// A line worth pulling out, typed onto a strip torn from a sheet.
//   <Pullquote>The resting state is the finished drawing.</Pullquote>
//   <Pullquote cite="Someone wise">…</Pullquote>
interface Props { cite?: string }
const { cite } = Astro.props;
---
<figure class="pullquote">
  <blockquote class="typed"><slot /></blockquote>
  {cite && <figcaption>{cite}</figcaption>}
</figure>

<style>
  .pullquote { grid-column: wide; margin: 2.4rem 0 2.6rem; rotate: -.8deg; isolation: isolate; position: relative; }
  /* the strip, torn at both ends */
  .pullquote::before {
    content: ""; position: absolute; inset: 0 -.5rem; z-index: -1;
    background: var(--sheet) url("../../assets/paper/grain.webp") 0 0 / 800px;
    background-blend-mode: multiply;
    clip-path: polygon(1% 0, 99% 0, 100% 12%, 98.6% 26%, 100% 41%, 98.8% 57%, 100% 72%, 98.5% 87%, 99.4% 100%, .8% 100%, 0 88%, 1.4% 73%, 0 58%, 1.2% 43%, 0 28%, 1.5% 13%);
  }
  /* not the prose blockquote: no rule, no italics, typed */
  .pullquote blockquote { margin: 0; border: 0; font-style: normal; padding: 1.5rem clamp(1.4rem, 5vw, 3rem); font-size: clamp(1.1rem, 2.2vw, 1.3rem); line-height: 1.55; letter-spacing: .01em; }
  blockquote :global(p) { margin: 0; }
  figcaption { position: absolute; right: 2rem; bottom: -1.6rem; font-style: italic; color: var(--pencil); font-size: .98rem; }
  figcaption::before { content: "\2014\00a0"; }
  @media (max-width: 40rem) { .pullquote { grid-column: text; } }
</style>
